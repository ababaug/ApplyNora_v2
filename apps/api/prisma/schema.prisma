generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  role                    String                   @default("USER")
  status                  String                   @default("ACTIVE")
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                UserSession[]
  candidateProfile        CandidateProfile?
  jobPreference           JobPreference?
  notificationPreference  NotificationPreference?
  securityEvents          SecurityEvent[]
  documents               Document[]
  cvs                     CV[]
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  firstName            String
  lastName             String
  phone                String?
  professionalHeadline String?
  professionalSummary  String?
  location             String?
  yearsOfExperience    Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  targetJobTitles   String[]
  preferredLocations String[]
  workArrangement   String?
  employmentTypes   String[]
  expectedSalaryMin Int?
  expectedSalaryMax Int?
  currency          String?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                    String  @id @default(uuid())
  userId                String  @unique
  emailEnabled          Boolean @default(true)
  telegramEnabled       Boolean @default(false)
  jobMatchNotifications Boolean @default(true)
  applicationUpdates    Boolean @default(true)
  interviewReminders    Boolean @default(true)
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  timestamp DateTime @default(now())
  metadata  Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id               String   @id @default(uuid())
  userId           String
  name             String
  originalFilename String
  mimeType         String
  size             Int
  storageKey       String   @unique
  status           String   @default("UPLOADED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  versions         DocumentVersion[]
  processingJobs   DocumentProcessingJob[]
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  versionNumber Int
  storageKey    String   @unique
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model CV {
  id             String   @id @default(uuid())
  userId         String
  title          String
  templateId     String   @default("professional")
  structuredData Json
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  versions       CVVersion[]
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CVVersion {
  id             String   @id @default(uuid())
  cvId           String
  versionNumber  Int
  structuredData Json
  createdAt      DateTime @default(now())
  cv             CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
}

model DocumentProcessingJob {
  id          String   @id @default(uuid())
  documentId  String
  status      String   @default("PENDING")
  errorCode   String?
  startedAt   DateTime?
  completedAt DateTime?
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}